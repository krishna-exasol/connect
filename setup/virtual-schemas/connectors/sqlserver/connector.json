{
  "id": "sqlserver",
  "name": "SQL Server",
  "profile": "java-jdbc",
  "upstream": "exasol/sqlserver-virtual-schema",
  "adapter": {
    "version": "3.0.1",
    "asset": "virtual-schema-dist-14.0.4-sqlserver-3.0.1.jar",
    "url": "https://github.com/exasol/sqlserver-virtual-schema/releases/download/3.0.1/virtual-schema-dist-14.0.4-sqlserver-3.0.1.jar",
    "size": 536114,
    "sha256": "28097686ef11b59ff7045650d05f6254c2701d5dd47ca99c521943bc5e1e16c5",
    "license": "MIT"
  },
  "driver": {
    "version": "13.4.0.jre8",
    "asset": "mssql-jdbc-13.4.0.jre8.jar",
    "url": "https://repo1.maven.org/maven2/com/microsoft/sqlserver/mssql-jdbc/13.4.0.jre8/mssql-jdbc-13.4.0.jre8.jar",
    "size": 1534598,
    "sha256": "81b6b9860c713b53c237bd31f6d650251517818a83d93e5e99fdff250a25f8d3",
    "license": "MIT"
  },
  "etl": {
    "drivername": "SQLSERVER",
    "prefix": "jdbc:sqlserver:",
    "main": "com.microsoft.sqlserver.jdbc.SQLServerDriver",
    "nosecurity": true
  },
  "inputs": [
    {
      "name": "host",
      "label": "Host name or address",
      "kind": "host",
      "required": true
    },
    {
      "name": "port",
      "label": "Port",
      "kind": "port",
      "default": 1433
    },
    {
      "name": "database",
      "label": "Database",
      "kind": "name",
      "required": true
    },
    {
      "name": "schema",
      "label": "Schema",
      "kind": "name",
      "default": "dbo"
    },
    {
      "name": "user",
      "label": "Reader account",
      "kind": "text",
      "required": true
    },
    {
      "name": "password",
      "label": "Password",
      "kind": "secret",
      "required": true
    },
    {
      "name": "tls",
      "label": "TLS",
      "kind": "choice",
      "default": "verify",
      "choices": [
        "verify",
        "require",
        "disable"
      ]
    },
    {
      "name": "ca",
      "label": "CA certificate file (PEM) - only for a private CA such as AWS RDS or Azure; Enter to skip",
      "kind": "ca-file"
    }
  ],
  "auth": "password",
  "url": "jdbc:sqlserver://{host}:{port};databaseName={database};{tls}",
  "tls": {
    "verify": "encrypt=true;trustServerCertificate=false;hostNameInCertificate={host}",
    "require": "encrypt=true;trustServerCertificate=true",
    "disable": "encrypt=false"
  },
  "tls_truststore": "encrypt=true;trustServerCertificate=false;hostNameInCertificate={host};trustStore={truststore};trustStoreType=JKS",
  "vs_properties": {
    "CATALOG_NAME": "{database}",
    "SCHEMA_NAME": "{schema}"
  },
  "notes": [
    "SQL Server login only; Windows authentication and Entra ID are not part of this connector.",
    "Exasol tested the jre8 build of mssql-jdbc 13.4.0; it runs on the Java 17 container.",
    "A server with a private CA (AWS RDS, Azure, a company CA) is verified against it with --set ca=<PEM file or bundle>: mssql-jdbc reads trust only from a file, so the kit writes the bundle as a JKS truststore for this source and gives its path relative to where both the adapter and the loader start."
  ]
}
